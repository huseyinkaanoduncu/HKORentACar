@using System.Globalization
@model dynamic

@{
    var arac = ViewBag.Arac as HKORentACar.Core.Concretes.DTOs.AracDto;
    ViewData["Title"] = "Araç Kirala - " + (arac != null ? $"{arac.Marka} {arac.Model}" : "Rezervasyon");

    DateTime baslangicTarihi = ViewBag.BaslangicTarihi is DateTime dtBas ? dtBas : DateTime.Now;
    DateTime bitisTarihi = ViewBag.BitisTarihi is DateTime dtBit ? dtBit : DateTime.Now.AddDays(2);
}

<style>
    :root {
        --brand-orange: #e85012;
        --brand-orange-hover: #cf430b;
    }

    .booking-summary-card {
        border-radius: 24px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .booking-form-card {
        border-radius: 24px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.05);
    }

    .form-control-custom {
        background-color: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px 16px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .form-control-custom:focus {
            background-color: #ffffff;
            border-color: var(--brand-orange);
            box-shadow: 0 0 0 4px rgba(232, 80, 18, 0.12);
        }

    .badge-plate-custom {
        font-family: monospace;
        letter-spacing: 1px;
        background: #0f172a;
        color: #ffffff;
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 0.8rem;
    }

    .btn-brand-action {
        background: linear-gradient(135deg, var(--brand-orange) 0%, var(--brand-orange-hover) 100%);
        color: #ffffff;
        border: none;
        border-radius: 14px;
        font-weight: 700;
        letter-spacing: 0.3px;
        transition: transform 0.15s ease, box-shadow 0.2s ease;
    }

        .btn-brand-action:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -5px rgba(232, 80, 18, 0.4);
        }
</style>

<div class="container my-5">
    <div class="row g-4 align-items-start">
        <div class="col-lg-5">
            <div class="booking-summary-card sticky-top" style="top: 24px;">
                <div class="position-relative bg-light overflow-hidden" style="height: 230px;">
                    <img src="@(string.IsNullOrEmpty(arac?.ResimUrl) ? "https://via.placeholder.com/500x300?text=Resim+Yok" : arac.ResimUrl)"
                         class="w-100 h-100"
                         alt="@arac?.Marka @arac?.Model"
                         style="object-fit: cover;"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/500x300?text=Resim+Yok';" />

                    <span class="badge position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm bg-success bg-gradient text-white">
                        Müsait
                    </span>
                </div>

                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="fw-bold mb-1 text-dark">@arac?.Marka @arac?.Model</h4>
                            <span class="badge-plate-custom">@arac?.Plaka</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between p-3 my-3 rounded-3 bg-light border text-secondary small">
                        <div class="text-center">
                            <span class="d-block text-muted" style="font-size: 0.72rem; font-weight: 700;">MODEL YILI</span>
                            <strong class="text-dark">@arac?.Yil</strong>
                        </div>
                        <div class="border-start"></div>
                        <div class="text-center">
                            <span class="d-block text-muted" style="font-size: 0.72rem; font-weight: 700;">MEVCUT KM</span>
                            <strong class="text-dark">@(arac?.KM.ToString("N0") ?? "0") KM</strong>
                        </div>
                        <div class="border-start"></div>
                        <div class="text-center">
                            <span class="d-block text-muted" style="font-size: 0.72rem; font-weight: 700;">GÜNLÜK</span>
                            <strong class="text-dark" id="birimUcret" data-ucret="@((arac?.GunlukUcret ?? 0).ToString(CultureInfo.InvariantCulture))">@(arac?.GunlukUcret.ToString("N0") ?? "0") ₺</strong>
                        </div>
                    </div>

                    <div class="p-3 rounded-4" style="background: #fff7ed; border: 1.5px dashed #fdba74;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold">Kiralama Süresi</span>
                            <span class="fw-bold text-dark" id="ozetGunSayisi">1 Gün</span>
                        </div>

                        <div id="erkenIndirimRozeti" class="d-none justify-content-between align-items-center py-1 text-success small fw-semibold">
                            <span>🎉 Erken Rezervasyon (%15):</span>
                            <span id="indirimTutari">-0 ₺</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-baseline pt-2 border-top border-warning border-opacity-25">
                            <span class="fw-bold text-dark">Toplam Tutar:</span>
                            <div>
                                <del class="text-muted small d-none me-1" id="orijinalTutar"></del>
                                <span class="fs-4 fw-bold" style="color: var(--brand-orange);" id="ozetToplamTutar">
                                    @(arac?.GunlukUcret.ToString("N0") ?? "0") ₺
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 text-center">
                        <small class="text-muted">⚡ KDV, zorunlu trafik ve standart kasko dahildir.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="booking-form-card p-4 p-md-5">
                <span class="text-uppercase fw-bold small" style="color: var(--brand-orange); letter-spacing: 1px;">Adım 2 / 2</span>
                <h3 class="fw-bold mb-1 text-dark">Rezervasyon Bilgileri</h3>
                <p class="text-muted small mb-4">Aracı teslim almak ve iade etmek istediğiniz tarih ve saatleri belirleyin.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Kirala" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="aracId" value="@arac?.Id" />

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase mb-1">📍 Teslim Alma Tarihi & Saati</label>
                            <input type="datetime-local"
                                   id="baslangicTarihi"
                                   name="baslangicTarihi"
                                   class="form-control form-control-custom shadow-none"
                                   value="@baslangicTarihi.ToString("yyyy-MM-ddTHH:mm")"
                                   required
                                   onchange="hesaplaUcret()" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase mb-1">📍 İade Etme Tarihi & Saati</label>
                            <input type="datetime-local"
                                   id="bitisTarihi"
                                   name="bitisTarihi"
                                   class="form-control form-control-custom shadow-none"
                                   value="@bitisTarihi.ToString("yyyy-MM-ddTHH:mm")"
                                   required
                                   onchange="hesaplaUcret()" />
                        </div>

                        <div class="col-12">
                            <div class="p-3 rounded-4 bg-light border d-flex gap-3 align-items-center">
                                <span class="fs-2">🛡️</span>
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">HKO Güvence & Destek Paketi</h6>
                                    <p class="text-muted small mb-0">Aracınız tam kaskoludur. Şubeden teslim alırken kimlik ve sürücü belgenizi ibraz etmeniz yeterlidir.</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-brand-action btn-lg w-100 py-3 shadow-sm">
                                🚀 Rezervasyonu Tamamla ve Kirala
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-link text-decoration-none text-muted w-100 mt-2 py-2 small fw-semibold">
                                ← Vazgeç ve Ana Sayfaya Dön
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function hesaplaUcret() {
            const baslangicEl = document.getElementById('baslangicTarihi');
            const bitisEl = document.getElementById('bitisTarihi');
            const birimUcretEl = document.getElementById('birimUcret');

            if (!baslangicEl || !bitisEl || !birimUcretEl) return;

            const baslangic = new Date(baslangicEl.value);
            const bitis = new Date(bitisEl.value);
            const bugun = new Date();

            const birimUcretStr = birimUcretEl.getAttribute('data-ucret') || "0";
            const birimUcret = parseFloat(birimUcretStr.replace(',', '.')) || 0;

            const indirimRozeti = document.getElementById('erkenIndirimRozeti');
            const indirimTutariSpan = document.getElementById('indirimTutari');
            const orijinalTutarDel = document.getElementById('orijinalTutar');
            const ozetGunSayisi = document.getElementById('ozetGunSayisi');
            const ozetToplamTutar = document.getElementById('ozetToplamTutar');

            if (bitis > baslangic) {
                const diffTime = bitis.getTime() - baslangic.getTime();
                let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (diffDays <= 0) diffDays = 1;

                let hamToplam = diffDays * birimUcret;
                let sonToplam = hamToplam;

                // Saat farkından etkilenmemek için gün bazında fark hesabı
                const baslangicGun = new Date(baslangic.getFullYear(), baslangic.getMonth(), baslangic.getDate());
                const bugunGun = new Date(bugun.getFullYear(), bugun.getMonth(), bugun.getDate());
                const gunFarkiBugun = Math.round((baslangicGun - bugunGun) / (1000 * 60 * 60 * 24));

                if (gunFarkiBugun >= 7) {
                    const indirim = hamToplam * 0.15;
                    sonToplam = hamToplam - indirim;

                    indirimRozeti.classList.remove('d-none');
                    indirimRozeti.classList.add('d-flex');
                    indirimTutariSpan.innerText = "-" + Math.round(indirim).toLocaleString('tr-TR') + " ₺";

                    orijinalTutarDel.classList.remove('d-none');
                    orijinalTutarDel.innerText = Math.round(hamToplam).toLocaleString('tr-TR') + " ₺";
                } else {
                    indirimRozeti.classList.add('d-none');
                    indirimRozeti.classList.remove('d-flex');
                    orijinalTutarDel.classList.add('d-none');
                }

                ozetGunSayisi.innerText = diffDays + " Gün";
                ozetToplamTutar.innerText = Math.round(sonToplam).toLocaleString('tr-TR') + " ₺";
            } else {
                ozetGunSayisi.innerText = "Hatalı Tarih";
                ozetToplamTutar.innerText = "0 ₺";
                indirimRozeti.classList.add('d-none');
                indirimRozeti.classList.remove('d-flex');
                orijinalTutarDel.classList.add('d-none');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(hesaplaUcret, 50);
        });
    </script>
}