@model IEnumerable<HKORentACar.Core.Concretes.Entities.Kiralama>

@{
    ViewData["Title"] = "Filo & Teslimat Yönetimi - Admin";
    decimal toplamCiro = ViewBag.ToplamCiro ?? 0;
    int aktifKiralama = ViewBag.AktifKiralamaSayisi ?? 0;
    int toplamArac = ViewBag.ToplamAracSayisi ?? 0;
    int musaitArac = ViewBag.MusaitAracSayisi ?? 0;
}

<style>
    :root {
        --brand-orange: #e85012;
        --brand-orange-hover: #cf430b;
        --dark-card: #0f172a;
    }

    .kpi-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 1.25rem 1.5rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px -8px rgba(0, 0, 0, 0.08);
        }

    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .table-container-card {
        border-radius: 22px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .custom-table th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #64748b;
        font-weight: 700;
        background: #f8fafc;
        border-bottom: 1.5px solid #e2e8f0;
        padding: 14px 16px;
    }

    .custom-table td {
        padding: 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }

    .plate-badge-admin {
        font-family: monospace;
        letter-spacing: 0.5px;
        background: #1e293b;
        color: #ffffff;
        border-radius: 6px;
        padding: 2px 8px;
        font-size: 0.75rem;
    }

    .km-input-field {
        background: #f8fafc;
        border: 1.5px solid #cbd5e1;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: border-color 0.2s ease;
    }

        .km-input-field:focus {
            border-color: var(--brand-orange);
            background: #ffffff;
            box-shadow: none;
        }

    .btn-deliver {
        background: #059669;
        color: #ffffff;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.82rem;
        border: none;
        transition: all 0.2s ease;
    }

        .btn-deliver:hover {
            background: #047857;
            color: #ffffff;
            transform: translateY(-1px);
        }
</style>

<div class="container my-5">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="text-uppercase fw-bold small" style="color: var(--brand-orange); letter-spacing: 1px;">Yönetim Masası</span>
            <h2 class="fw-bold mb-1 text-dark">🛠️ Filo Operasyon & Teslimat</h2>
            <p class="text-muted mb-0">Aktif rezervasyonları izleyin, araç iadelerini ve filo kilometrelerini güncelleyin.</p>
        </div>
        <a asp-controller="Arac" asp-action="Create" class="btn btn-dark rounded-pill px-4 py-2 fw-semibold small shadow-sm align-self-start align-self-md-center">
            ➕ Yeni Araç Ekle
        </a>
    </div>

    
    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center justify-content-between p-3" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">✅</span>
                <span class="fw-semibold">@TempData["Basari"]</span>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

   
    <div class="row g-3 mb-4">
       
        <div class="col-lg-3 col-sm-6">
            <div class="kpi-card d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">TOPLAM CİRO</span>
                    <h3 class="fw-bold mt-1 mb-0 text-dark">@toplamCiro.ToString("N0") ₺</h3>
                </div>
                <div class="kpi-icon" style="background: #ecfdf5; color: #059669;">
                    💰
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="kpi-card d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">AKTİF KİRADA</span>
                    <h3 class="fw-bold mt-1 mb-0" style="color: var(--brand-orange);">@aktifKiralama <small class="fs-6 text-muted fw-normal">Araç</small></h3>
                </div>
                <div class="kpi-icon" style="background: #fff7ed; color: var(--brand-orange);">
                    🔑
                </div>
            </div>
        </div>

      
        <div class="col-lg-3 col-sm-6">
            <div class="kpi-card d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">MÜSAİT ARAÇLAR</span>
                    <h3 class="fw-bold mt-1 mb-0 text-success">@musaitArac <small class="fs-6 text-muted fw-normal">Araç</small></h3>
                </div>
                <div class="kpi-icon" style="background: #f0fdf4; color: #16a34a;">
                    ✅
                </div>
            </div>
        </div>

        
        <div class="col-lg-3 col-sm-6">
            <div class="kpi-card d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">TOPLAM FİLO</span>
                    <h3 class="fw-bold mt-1 mb-0 text-dark">@toplamArac <small class="fs-6 text-muted fw-normal">Araç</small></h3>
                </div>
                <div class="kpi-icon" style="background: #f8fafc; color: #334155;">
                    🚗
                </div>
            </div>
        </div>
    </div>

    
    <div class="table-container-card">
        <div class="p-4 border-bottom bg-white d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark">Kiralama Kayıtları & İade İşlemleri</h5>
                <small class="text-muted">Son işlemler ve araç bazlı kilometre mutabakatları</small>
            </div>
            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill fw-semibold">
                Toplam Kayıt: @Model.Count()
            </span>
        </div>

        <div class="table-responsive">
            <table class="table custom-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Rez. ID</th>
                        <th>Araç & Plaka</th>
                        <th>Alış Tarihi</th>
                        <th>İade Tarihi</th>
                        <th>Kira Bedeli</th>
                        <th>Operasyon Durumu</th>
                        <th class="text-center pe-4" style="width: 270px;">İade / Teslim Al (KM)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="display-6 mb-2 opacity-50">📦</div>
                                <h6 class="fw-bold">Kayıt Bulunamadı</h6>
                                <small>Sistemde henüz oluşturulmuş bir kiralama kaydı yok.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            bool isAktif = item.Durum.ToString() == "Aktif" || item.Durum.ToString() == "0";

                            <tr>
                                <td class="ps-4 fw-bold text-secondary">
                                    #@item.Id
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div>
                                            <strong class="text-dark d-block">@item.Arac?.Marka @item.Arac?.Model</strong>
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <span class="plate-badge-admin">@item.Arac?.Plaka</span>
                                                <small class="text-muted">Mevcut: @item.Arac?.KM.ToString("N0") KM</small>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-secondary small">
                                    <span class="fw-semibold text-dark d-block">@item.BaslangicTarihi.ToString("dd MMM yyyy")</span>
                                    <span>@item.BaslangicTarihi.ToString("HH:mm")</span>
                                </td>
                                <td class="text-secondary small">
                                    <span class="fw-semibold text-dark d-block">@item.BitisTarihi.ToString("dd MMM yyyy")</span>
                                    <span>@item.BitisTarihi.ToString("HH:mm")</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@item.ToplamUcret.ToString("N0") ₺</strong>
                                </td>
                                <td>
                                    @if (isAktif)
                                    {
                                        <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 fw-semibold">
                                            ● Müşteride (Aktif)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 fw-semibold">
                                            ✓ Teslim Alındı
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-center">
                                    @if (isAktif)
                                    {
                                        <form asp-action="TeslimAl" method="post" class="d-flex gap-2 justify-content-center align-items-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="kiralamaId" value="@item.Id" />
                                            <input type="number"
                                                   name="teslimEdilenKm"
                                                   class="form-control form-control-sm km-input-field text-center shadow-none"
                                                   style="width: 115px;"
                                                   placeholder="Yeni KM"
                                                   min="@item.Arac?.KM"
                                                   value="@((item.Arac?.KM ?? 0) + 120)"
                                                   title="Mevcut KM'den küçük olamaz"
                                                   required />
                                            <button type="submit" class="btn btn-deliver px-3 py-1 shadow-sm" onclick="return confirm('Araç teslim alınıp tekrar MÜSAİT duruma getirilsin mi?');">
                                                Teslim Al
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="small text-muted fw-semibold">
                                            Tamamlandı <span class="badge bg-light text-dark border">@item.TeslimEdilenKM KM</span>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>