@model IEnumerable<HKORentACar.Core.Concretes.Entities.Kiralama>

@{
    ViewData["Title"] = "Rezervasyonlarım - HKO Rent A Car";
}

<style>
    :root {
        --brand-orange: #e85012;
        --brand-orange-hover: #cf430b;
    }

    .booking-card {
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }

        .booking-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 30px -10px rgba(0, 0, 0, 0.08);
            border-color: #cbd5e1;
        }

    .booking-img-wrap {
        position: relative;
        min-height: 180px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

        .booking-img-wrap img {
            max-height: 130px;
            width: 100%;
            object-fit: cover;
            border-radius: 14px;
            transition: transform 0.3s ease;
        }

    .booking-card:hover .booking-img-wrap img {
        transform: scale(1.03);
    }

    .plate-badge {
        font-family: monospace;
        font-size: 0.85rem;
        letter-spacing: 1px;
        background: #0f172a;
        color: #ffffff;
        border-radius: 8px;
        padding: 4px 10px;
    }

    .status-badge {
        border-radius: 30px;
        padding: 6px 14px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        display: inline-block;
    }

    .btn-brand-sm {
        background: linear-gradient(135deg, var(--brand-orange) 0%, var(--brand-orange-hover) 100%);
        color: #fff;
        border-radius: 50rem;
        font-weight: 600;
        transition: all 0.2s ease;
        border: none;
    }

        .btn-brand-sm:hover {
            color: #fff;
            box-shadow: 0 6px 16px rgba(232, 80, 18, 0.35);
            transform: translateY(-1px);
        }
</style>

<div class="container my-5">
  
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="text-uppercase fw-bold small" style="color: var(--brand-orange); letter-spacing: 1px;">Müşteri Paneli</span>
            <h2 class="fw-bold mb-1 text-dark">📋 Rezervasyonlarım</h2>
            <p class="text-muted mb-0">Aktif ve geçmiş araç kiralama işlemlerinizi buradan yönetebilirsiniz.</p>
        </div>
        <a asp-controller="Arac" asp-action="Index" class="btn btn-brand-sm px-4 py-2 text-decoration-none shadow-sm align-self-start align-self-md-center">
            + Yeni Araç Rezerve Et
        </a>
    </div>

   
    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center justify-content-between p-3" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">✅</span>
                <span class="fw-semibold">@TempData["Basari"]</span>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center justify-content-between p-3" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">⚠️</span>
                <span class="fw-semibold">@TempData["Hata"]</span>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 my-5 bg-white">
            <div class="display-4 text-muted mb-3 opacity-50">🚗</div>
            <h4 class="fw-bold text-dark">Henüz Bir Kiralamanız Bulunmuyor</h4>
            <p class="text-muted mx-auto" style="max-width: 480px;">
                Filomuzdaki en yeni modelleri avantajlı fiyatlar ve tam güvence seçenekleriyle keşfetmeye hemen başlayın.
            </p>
            <div class="mt-3">
                <a asp-controller="Arac" asp-action="Index" class="btn btn-brand-sm px-4 py-2 text-decoration-none shadow-sm">
                    Filoyu Keşfet
                </a>
            </div>
        </div>
    }
    else
    {
        
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var toplamGun = (item.BitisTarihi - item.BaslangicTarihi).Days;
                if (toplamGun <= 0) { toplamGun = 1; }
                bool isAktif = item.Durum.ToString() == "Aktif" || item.Durum.ToString() == "0";
                bool isTamamlandi = item.Durum.ToString() == "Tamamlandi" || item.Durum.ToString() == "1";

                <div class="col-12">
                    <div class="booking-card">
                        <div class="row g-0 align-items-stretch">

                            
                            <div class="col-lg-3 col-md-4 booking-img-wrap">
                                <img src="@(string.IsNullOrEmpty(item.Arac?.ResimUrl) ? "https://via.placeholder.com/320x200?text=Resim+Yok" : item.Arac.ResimUrl)"
                                     alt="@item.Arac?.Marka @item.Arac?.Model"
                                     onerror="this.onerror=null; this.src='https://via.placeholder.com/320x200?text=Resim+Yok';" />
                            </div>

                          
                            <div class="col-lg-6 col-md-5 p-4 d-flex flex-column justify-content-center border-start-md">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <h5 class="fw-bold mb-0 text-dark">@item.Arac?.Marka @item.Arac?.Model</h5>
                                    <span class="plate-badge">@item.Arac?.Plaka</span>
                                </div>

                                <div class="row g-3 text-secondary small">
                                    <div class="col-sm-6">
                                        <div class="p-2 rounded-3 bg-light border">
                                            <span class="text-muted d-block" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase;">📅 Alış Tarihi</span>
                                            <strong class="text-dark">@item.BaslangicTarihi.ToString("dd MMMM yyyy HH:mm")</strong>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-2 rounded-3 bg-light border">
                                            <span class="text-muted d-block" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase;">📅 İade Tarihi</span>
                                            <strong class="text-dark">@item.BitisTarihi.ToString("dd MMMM yyyy HH:mm")</strong>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <span class="text-muted fw-semibold">📍 Teslim Şubesi:</span>
                                        <span class="fw-bold text-dark">@(item.Sube?.SehirAdi ?? "Merkez Şube")</span>
                                    </div>
                                </div>
                            </div>

                            
                            <div class="col-lg-3 col-md-3 p-4 bg-light bg-opacity-50 border-start d-flex flex-column justify-content-between text-md-end text-start">
                                <div>
                                    <div class="mb-3">
                                        @if (isAktif)
                                        {
                                            <span class="status-badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                ● Devam Ediyor
                                            </span>
                                        }
                                        else if (isTamamlandi)
                                        {
                                            <span class="status-badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                                ✓ Tamamlandı
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                                ✕ İptal Edildi
                                            </span>
                                        }
                                    </div>

                                    <small class="text-muted d-block fw-medium">Toplam (@toplamGun Günlük)</small>
                                    <span class="fs-4 fw-bold" style="color: var(--brand-orange);">@item.ToplamUcret.ToString("N0") ₺</span>
                                </div>

                                @if (isAktif)
                                {
                                    <div class="mt-4 pt-2 border-top">
                                        <form asp-action="IptalEt" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu kiralama rezervasyonunu iptal etmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-semibold shadow-none">
                                                Rezervasyonu İptal Et
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>